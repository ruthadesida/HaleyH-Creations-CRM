  ('a0000000-0000-0000-0000-000000000003', 'production.a@test.dev', 'authenticated', 'authenticated'),
  ('a0000000-0000-0000-0000-000000000004', 'former.a@test.dev', 'authenticated', 'authenticated'),
  ('b0000000-0000-0000-0000-000000000001', 'owner.b@test.dev', 'authenticated', 'authenticated'),
  ('c0000000-0000-0000-0000-000000000001', 'admin@test.dev', 'authenticated', 'authenticated');

