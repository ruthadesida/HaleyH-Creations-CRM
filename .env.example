# Copy to .env.local and fill in. Never commit real values.

# Supabase (added when the database is connected)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose to the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Public base URL of the app, used in auth emails. e.g. https://crm.haleyhcreations.com
SITE_URL=http://localhost:3000

